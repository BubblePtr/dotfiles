#!/bin/bash
# rerun when the statusline script changes: {{ include "dot_claude/statusline.mjs" | sha256sum }}
set -euo pipefail

# CHEZMOI_HOME_DIR honours --destination; $HOME is the fallback for a manual run.
home="${CHEZMOI_HOME_DIR:-$HOME}"
settings="${home}/.claude/settings.json"
script="${home}/.claude/statusline.mjs"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq not on PATH; skip Claude statusline wiring" >&2
  exit 0
fi

# Check the source, not the target: within one apply the target may not be
# written yet, and entries are applied in lexicographic order.
if [[ ! -f "${script}" && ! -f "${CHEZMOI_SOURCE_DIR:-/nonexistent}/dot_claude/statusline.mjs" ]]; then
  echo "statusline.mjs not managed and not present; skip Claude statusline wiring" >&2
  exit 0
fi

# Absolute runtime path: the statusline subprocess may not inherit mise shims on PATH.
runtime="$(command -v bun || command -v node || true)"
if [[ -z "${runtime}" ]]; then
  echo "neither bun nor node on PATH; skip Claude statusline wiring" >&2
  exit 0
fi

# bun auto-loads .env from cwd, which would leak project vars into the statusline.
# node never does, and the flag only exists on node >= 20.6.
if [[ "$(basename "${runtime}")" == "bun" ]]; then
  cmd="${runtime} --env-file /dev/null ${script}"
else
  cmd="${runtime} ${script}"
fi

mkdir -p "$(dirname "${settings}")"
[[ -f "${settings}" ]] || printf '{}\n' > "${settings}"

# Merge only the statusLine key; the rest of settings.json stays machine-local.
tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT
jq --arg cmd "${cmd}" \
  '.statusLine = {type: "command", command: $cmd, refreshInterval: 5}' \
  "${settings}" > "${tmp}"

if cmp -s "${tmp}" "${settings}"; then
  exit 0
fi
cat "${tmp}" > "${settings}"
chmod 600 "${settings}"
echo "wired Claude statusline via ${runtime}"
