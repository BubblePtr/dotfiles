#!/bin/bash
# rerun when the statusline script changes: {{ include "dot_claude/statusline.mjs" | sha256sum }}
set -euo pipefail

# CHEZMOI_HOME_DIR honours --destination; $HOME is the fallback for a manual run.
home="${CHEZMOI_HOME_DIR:-$HOME}"
settings="${home}/.claude/settings.json"
script="${home}/.claude/statusline.mjs"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq not on PATH; skip Claude settings" >&2
  exit 0
fi

# The statusline is optional: a fresh machine may not have a JS runtime yet
# (mise installs it later in the same apply). Missing it must not stop the
# memory switches below from being pinned, so it only contributes one key.
cmd=""
# Check the source, not the target: within one apply the target may not be
# written yet, and entries are applied in lexicographic order.
if [[ ! -f "${script}" && ! -f "${CHEZMOI_SOURCE_DIR:-/nonexistent}/dot_claude/statusline.mjs" ]]; then
  echo "statusline.mjs not managed and not present; leaving statusLine alone" >&2
else
  # Absolute runtime path: the statusline subprocess may not inherit mise shims on PATH.
  runtime="$(command -v bun || command -v node || true)"
  if [[ -z "${runtime}" ]]; then
    echo "neither bun nor node on PATH; leaving statusLine alone" >&2
  # bun auto-loads .env from cwd, which would leak project vars into the statusline.
  # node never does, and the flag only exists on node >= 20.6.
  elif [[ "$(basename "${runtime}")" == "bun" ]]; then
    cmd="${runtime} --env-file /dev/null ${script}"
  else
    cmd="${runtime} ${script}"
  fi
fi

mkdir -p "$(dirname "${settings}")"
[[ -f "${settings}" ]] || printf '{}\n' > "${settings}"

# Nowledge Mem is the single source of truth for memory, so the built-in
# capture must stay off on every machine; CLAUDE.md states the same rule but
# only settings.json enforces it. Everything else stays machine-local.
filter='.autoMemoryEnabled = false | .autoDreamEnabled = false'
if [[ -n "${cmd}" ]]; then
  filter="${filter} | .statusLine = {type: \"command\", command: \$cmd, refreshInterval: 5}"
fi

tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT
jq --arg cmd "${cmd}" "${filter}" "${settings}" > "${tmp}"

if cmp -s "${tmp}" "${settings}"; then
  exit 0
fi
cat "${tmp}" > "${settings}"
chmod 600 "${settings}"
echo "updated Claude settings${cmd:+ (statusline via ${runtime})}"
